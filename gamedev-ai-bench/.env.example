# Copy to .env. No credential below is real. CLI loads .env without overwriting env.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=sqlite:///var/bench.db
DATA_DIR=var
# Required in production: at least 48 random characters. Never expose to a browser.
APP_SECRET=
ALLOW_REGISTRATION=false
# Production requires PostgreSQL, HTTPS, a stable secret and a separate game origin.
GAME_ORIGIN=
CORS_ALLOWED_ORIGINS=
PUBLIC_API_BASE=
CONTACT_EMAIL=
LEGAL_ENTITY=
LEGAL_ADDRESS=
# Providers are opt-in; connection checks never trigger generation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
# A dedicated, reviewed isolated host is required for generated game evaluation.
SANDBOX_IMAGE=gamedev-web-sandbox:0.1.0
ENABLE_PAID_RUNS=false
# Stripe remains unavailable unless all required configuration is present.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional SMTP; use an app-specific credential and verified sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
